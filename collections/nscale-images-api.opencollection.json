{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nscale Serverless Inference Chat Images API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://inference.api.nscale.com/v1/images/generations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates one or more images based on the provided text prompt."
        }
      ]
    }
  ],
  "bundled": true
}