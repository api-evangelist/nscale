{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nscale Serverless Inference Chat Completions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Completions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://inference.api.nscale.com/v1/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a completion response for the provided model and prompt."
        }
      ]
    }
  ],
  "bundled": true
}